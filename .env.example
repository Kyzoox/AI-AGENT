# Clé de l'API Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèle par défaut : gemini-nano-banana-2.1, gemini-3.1-flash-image, gemini-3.1-flash-lite-image, gemini-3-pro-image
IMAGE_MODEL=gemini-nano-banana-2.1

# Dossier où les images sont enregistrées
IMAGE_OUTPUT_DIR=./generated

# Nombre maximal d'images par appel
IMAGE_MAX_PER_REQUEST=4

# API REST : jeton Bearer (obligatoire si IMAGE_API_HOST n'est pas 127.0.0.1)
IMAGE_API_TOKEN=
IMAGE_API_HOST=127.0.0.1
IMAGE_API_PORT=8000
